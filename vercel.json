{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-kj1ek8R2uT9FD3xERaxK6bVx/IvXQK85zlnlHFcw5Kk=' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://www.google.com/recaptcha/; frame-src https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/ https://assets.mailerlite.com; form-action https://assets.mailerlite.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/go/facebook",
      "destination": "/es?utm_source=facebook&utm_medium=profile&utm_campaign=always_on&utm_content=bio",
      "permanent": false
    },
    {
      "source": "/go/primera-visita",
      "destination": "/es/guides/first-sprakkafe?utm_source=facebook&utm_medium=organic&utm_campaign=agosto_2026&utm_content=aug_p_02",
      "permanent": false
    },
    {
      "source": "/hola",
      "destination": "/es?utm_source=personal&utm_medium=message&utm_campaign=agosto_2026&utm_content=contacto_reciente",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/es",
      "permanent": true
    },
    {
      "source": "/activity/:id",
      "destination": "/es/activity/:id",
      "permanent": true
    },
    {
      "source": "/organization/:id",
      "destination": "/es/organization/:id",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/es/activities",
      "destination": "/seo/es/activities.html"
    },
    {
      "source": "/en/activities",
      "destination": "/seo/en/activities.html"
    },
    {
      "source": "/es/guides",
      "destination": "/seo/es/guides.html"
    },
    {
      "source": "/en/guides",
      "destination": "/seo/en/guides.html"
    },
    {
      "source": "/es/guides/:slug",
      "destination": "/seo/es/guides/:slug.html"
    },
    {
      "source": "/en/guides/:slug",
      "destination": "/seo/en/guides/:slug.html"
    },
    {
      "source": "/en",
      "destination": "/en.html"
    },
    {
      "source": "/es/activity/:id",
      "destination": "/seo/es/activity/:id.html"
    },
    {
      "source": "/en/activity/:id",
      "destination": "/seo/en/activity/:id.html"
    },
    {
      "source": "/es/organization/:id",
      "destination": "/seo/es/organization/:id.html"
    },
    {
      "source": "/en/organization/:id",
      "destination": "/seo/en/organization/:id.html"
    },
    {
      "source": "/es/info/:page",
      "destination": "/seo/es/info/:page.html"
    },
    {
      "source": "/en/info/:page",
      "destination": "/seo/en/info/:page.html"
    },
    {
      "source": "/es",
      "destination": "/index.html"
    }
  ]
}
